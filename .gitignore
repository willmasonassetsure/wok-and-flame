# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example template, which is meant to be committed
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent state
.claude/

# client-supplied source images staged for import (originals; not served/shipped)
/_source-images/

# scratch — Just Eat scrape artifacts, image eyeball-test outputs,
# one-off scraping scripts (menu is finalised, no need to re-run)
.justeat-*
public/images/_test/
scripts/extract-justeat*.js
scripts/flatten-justeat.js

# Excel temp/lock dirs (created when an .xlsx is open in Excel) + manual
# timestamped backups dropped beside source files (e.g. menu.ts.bak.20260602_225052)
.xlsx-tmp/
*.bak.*
