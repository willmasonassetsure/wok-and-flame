# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so secrets stay out of the repo.
# NEVER paste real keys into this file — it's the public template.

# Google Places API (New) — used to fetch live Google reviews + rating
# for the Reviews section and the JSON-LD aggregateRating.
#
# How to get these:
#   1. API key:
#      console.cloud.google.com → APIs & Services → Credentials → Create API key
#      Enable: "Places API (New)"
#      Restrict: HTTP referrers (your live domain) + API restriction: Places API only
#
#   2. Place ID (public — manager access NOT required):
#      developers.google.com/maps/documentation/places/web-service/place-id
#      Type "Wok & Flame Burton Road M20 2LW" into the finder, the Place ID
#      appears beside the pin. Format looks like: ChIJN1t_tDeuEmsRUsoyG83frY4
#
# After setting these, restart `npm run dev` for them to take effect.

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
